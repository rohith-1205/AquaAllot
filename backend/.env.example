# Copy this file to backend/.env and fill in your own values.
# backend/.env is ignored by git, so your keys never get committed.

PORT=5000

# Razorpay TEST keys (https://dashboard.razorpay.com → Settings → API Keys, test mode)
# Leave empty to use simulated payments.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# MongoDB (optional). Without it the backend keeps data in memory.
MONGO_URI=mongodb://localhost:27017/

# MQTT link to the Wokwi ESP32. MQTT_TOPIC_ROOT must match TOPIC_ROOT in sketch.ino.
# Run `npm run check` in this folder to find a broker/port your network allows.
MQTT_BROKER=test.mosquitto.org
MQTT_PORT=8081
MQTT_TRANSPORT=websockets
MQTT_TOPIC_ROOT=aquaallot-demo-rohith1205
